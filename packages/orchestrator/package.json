{
  "name": "@runtime-evidence/orchestrator",
  "version": "0.0.0",
  "private": true,
  "description": "Verification lifecycle orchestration for runtime-evidence",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json --noEmit && node --test test/orchestrator.test.ts test/verification.test.ts test/verification-evidence.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@runtime-evidence/comparators": "0.0.0",
    "@runtime-evidence/config": "0.0.0",
    "@runtime-evidence/evidence-schema": "0.0.0",
    "@runtime-evidence/replay-http": "0.0.0",
    "typebox": "1.3.19",
    "yaml": "2.9.0"
  }
}
