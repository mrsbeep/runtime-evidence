{
  "name": "@runtime-evidence/orchestrator",
  "version": "0.1.0",
  "description": "Verification lifecycle orchestration for runtime-evidence",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "!dist/**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrsbeep/runtime-evidence.git",
    "directory": "packages/orchestrator"
  },
  "homepage": "https://github.com/mrsbeep/runtime-evidence#readme",
  "bugs": {
    "url": "https://github.com/mrsbeep/runtime-evidence/issues"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "tsc -p tsconfig.test.json --noEmit && node --test test/orchestrator.test.ts test/verification.test.ts test/verification-evidence.test.ts",
    "typecheck": "tsc -b"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@runtime-evidence/comparators": "0.1.0",
    "@runtime-evidence/config": "0.1.0",
    "@runtime-evidence/evidence-schema": "0.1.0",
    "@runtime-evidence/replay-http": "0.1.0",
    "typebox": "1.3.23",
    "yaml": "2.9.0"
  }
}
