{
  "name": "@runtime-evidence/evidence-schema",
  "version": "0.0.0",
  "private": true,
  "description": "Canonical evidence types and validation for runtime-evidence",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "node src/generate.ts && biome format --write ../../schemas/config-v1.json ../../schemas/scenario-v1.json ../../schemas/evidence-v1.json",
    "test": "tsc -p tsconfig.test.json --noEmit && node --test test/schemas.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "typebox": "1.3.19"
  }
}
